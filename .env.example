# Banco de dados
DATABASE_URL=postgresql+asyncpg://revold:revold_dev_only@localhost:5432/revold
DATABASE_URL_SYNC=postgresql+psycopg2://revold:revold_dev_only@localhost:5432/revold

# Redis
REDIS_URL=redis://localhost:6379/0

# Identidade (ADR-0003) — deixar em branco em dev para usar o adapter mock automaticamente
AUTH_PROVIDER=dev
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Checkout (ADR-0005)
CHECKOUT_PROVIDER=whatsapp-clicktochat
NICK_WHATSAPP_NUMBER=

# IA (ADR-0006)
LLM_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Frontend
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
