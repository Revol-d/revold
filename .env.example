# Banco de dados
# PERSISTENCE_PROVIDER: "postgres" (default) ou "azure-sql" -- ver o plano de migração
# Postgres -> Azure SQL (docs internos). Troca em andamento fase a fase; não mude o
# default num ambiente real sem ler o plano primeiro.
PERSISTENCE_PROVIDER=postgres
DATABASE_URL=postgresql+asyncpg://revold:revold_dev_only@localhost:5432/revold
DATABASE_URL_SYNC=postgresql+psycopg2://revold:revold_dev_only@localhost:5432/revold
# Só usados quando PERSISTENCE_PROVIDER=azure-sql (requer o serviço `mssql` do
# docker-compose.yml de pé, e o banco `revold` criado nele uma vez -- ver o comentário
# do serviço):
# DATABASE_URL=mssql+aioodbc://sa:revold_dev_only_1@localhost:1433/revold?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# DATABASE_URL_SYNC=mssql+pyodbc://sa:revold_dev_only_1@localhost:1433/revold?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Redis
REDIS_URL=redis://localhost:6379/0

# Identidade (ADR-0003) — deixar em branco em dev para usar o adapter mock automaticamente
AUTH_PROVIDER=dev
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sessão (ADR-0010) — cookie HttpOnly + Redis. O docker-compose.yml deste
# repositório não tem HTTPS em lugar nenhum (sem proxy reverso/certificado,
# ver ADR-0009) — por isso o default aqui é "false", senão o navegador
# descarta o cookie e login (storefront/admin-dashboard) simplesmente não
# funciona em `make dev` (achado ao rodar o primeiro teste E2E via browser
# real contra a stack local, ADR-0020). Em produção (Container Apps,
# ADR-0004, HTTPS de verdade) usar "true".
SESSION_COOKIE_SECURE=false

# Checkout (ADR-0005)
CHECKOUT_PROVIDER=whatsapp-clicktochat
NICK_WHATSAPP_NUMBER=

# Pagamento (ADR-0024) — "fake" (default) aprova sem rede nenhuma;
# "mercado_pago" cobra Pix de verdade (cartão não implementado nesta onda,
# ver ADR-0024). MERCADO_PAGO_WEBHOOK_SECRET é o segredo usado para
# validar a assinatura do webhook (ver
# libs/integrations/mercado-pago/src/revold_mercado_pago/webhook_signature.py)
# — não é a mesma coisa que o access_token.
PAYMENT_PROVIDER=fake
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PAYER_EMAIL=

# Notificações (libs/domains/notification) — por padrão só logadas (ver
# revold_notification.adapters.logging_channel); "smtp" (ADR-0018) e
# "whatsapp-business" (ADR-0025) são as opções reais.
LOW_STOCK_THRESHOLD=5
NOTIFICATION_PROVIDER=logging

# Canal de e-mail (ADR-0018) — só usado quando NOTIFICATION_PROVIDER=smtp.
# Ao contrário de Azure AD/Google/WhatsApp Business API, uma conta SMTP
# (SendGrid, SES, ou até Gmail com senha de app) é trivial de conseguir.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NICK_NOTIFICATION_EMAIL=

# Canal WhatsApp Business (Meta Cloud API, ADR-0025) — só usado quando
# NOTIFICATION_PROVIDER=whatsapp-business. Avisa a Nick (NICK_WHATSAPP_NUMBER,
# acima) de checkout/estoque baixo por WhatsApp em vez de e-mail/log.
# WHATSAPP_BUSINESS_TEMPLATE_NAME é opcional — sem ele, manda texto livre
# (só funciona dentro da janela de 24h de conversa da própria API; fora
# dela, a Meta exige um template aprovado, daí a variável).
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TEMPLATE_NAME=

# Eventos (ADR-0013) — "memory" só loga e não tem consumidor real; "celery"
# publica de verdade no broker Redis para o apps/ecommerce/event-worker consumir
# (precisa do serviço `worker` do docker-compose rodando).
EVENT_PUBLISHER=memory

# Blob storage de mídia (ADR-0015) — "local" grava em disco dentro do
# container do api-gateway (sem credencial nenhuma, serve em /media);
# "azure-blob" requer AZURE_STORAGE_CONNECTION_STRING.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_LOCAL_DIR=/app/media
MEDIA_STORAGE_LOCAL_BASE_URL=http://localhost:8000/media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=product-images
AZURE_STORAGE_PUBLIC_BASE_URL=

# API pública/parceiro (ADR-0016) — X-API-Key + rate limit por chave
PUBLIC_API_RATE_LIMIT=60
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60

# Webhook de saída (ADR-0016) — "logging" só loga; "http" entrega de
# verdade com retry/backoff. WEBHOOK_URLS vazio (default) não faz nenhuma
# chamada de rede: nenhum parceiro configurado ainda.
WEBHOOK_SENDER_PROVIDER=logging
WEBHOOK_URLS=

# IA (ADR-0006, ADR-0011) — deixar em branco em dev para usar o adapter mock automaticamente
LLM_PROVIDER=dev
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# LLM_PROVIDER=deepseek (ADR-0026) — chat vai pro DeepSeek (API compatível
# com o formato OpenAI, sem "deployment" pré-configurado como na Azure: o
# nome do modelo é só um parâmetro por chamada). O DeepSeek não tem
# endpoint de embeddings compatível, então embeddings continuam na Azure
# OpenAI — as 3 variáveis AZURE_OPENAI_* acima também precisam estar
# configuradas quando LLM_PROVIDER=deepseek.
# DEEPSEEK_MODEL não tem valor default de propósito (nomes de modelo do
# DeepSeek mudam com frequência) — confira o nome atual em
# https://api-docs.deepseek.com/ antes de configurar.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Frontend
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
# Só usada pelo storefront rodando DENTRO do docker-compose (Server
# Components fazem o fetch no servidor do Next.js, dentro do container —
# lá "localhost" é o próprio container, não o do api-gateway). Rodando o
# storefront fora do Docker, pode deixar em branco (cai para
# NEXT_PUBLIC_API_GATEWAY_URL).
API_GATEWAY_INTERNAL_URL=http://api-gateway:8000
