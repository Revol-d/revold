# Banco de dados
DATABASE_URL=postgresql+asyncpg://revold:revold_dev_only@localhost:5432/revold
DATABASE_URL_SYNC=postgresql+psycopg2://revold:revold_dev_only@localhost:5432/revold

# Redis
REDIS_URL=redis://localhost:6379/0

# Identidade (ADR-0003) — deixar em branco em dev para usar o adapter mock automaticamente
AUTH_PROVIDER=dev
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sessão (ADR-0010) — cookie HttpOnly + Redis. Secure=true por padrão;
# só usar "false" em dev local sem HTTPS (senão o navegador descarta o cookie).
SESSION_COOKIE_SECURE=true

# Checkout (ADR-0005)
CHECKOUT_PROVIDER=whatsapp-clicktochat
NICK_WHATSAPP_NUMBER=

# Notificações (core-notification) — canal real ainda não existe (WhatsApp
# Business API pendente de aprovação, sem serviço de e-mail configurado);
# por enquanto as notificações só são logadas (ver
# adapters_external/notification/logging_channel.py).
LOW_STOCK_THRESHOLD=5
NOTIFICATION_PROVIDER=logging

# Canal de e-mail (ADR-0018) — só usado quando NOTIFICATION_PROVIDER=smtp.
# Ao contrário de Azure AD/Google/WhatsApp Business API, uma conta SMTP
# (SendGrid, SES, ou até Gmail com senha de app) é trivial de conseguir.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NICK_NOTIFICATION_EMAIL=

# Eventos (ADR-0013) — "memory" só loga e não tem consumidor real; "celery"
# publica de verdade no broker Redis para o workers/event-worker consumir
# (precisa do serviço `worker` do docker-compose rodando).
EVENT_PUBLISHER=memory

# Blob storage de mídia (ADR-0015) — "local" grava em disco dentro do
# container do api-gateway (sem credencial nenhuma, serve em /media);
# "azure-blob" requer AZURE_STORAGE_CONNECTION_STRING.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_LOCAL_DIR=/app/media
MEDIA_STORAGE_LOCAL_BASE_URL=http://localhost:8000/media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=product-images
AZURE_STORAGE_PUBLIC_BASE_URL=

# API pública/parceiro (ADR-0016) — X-API-Key + rate limit por chave
PUBLIC_API_RATE_LIMIT=60
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60

# Webhook de saída (ADR-0016) — "logging" só loga; "http" entrega de
# verdade com retry/backoff. WEBHOOK_URLS vazio (default) não faz nenhuma
# chamada de rede: nenhum parceiro configurado ainda.
WEBHOOK_SENDER_PROVIDER=logging
WEBHOOK_URLS=

# IA (ADR-0006, ADR-0011) — deixar em branco em dev para usar o adapter mock automaticamente
LLM_PROVIDER=dev
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Frontend
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
# Só usada pelo storefront rodando DENTRO do docker-compose (Server
# Components fazem o fetch no servidor do Next.js, dentro do container —
# lá "localhost" é o próprio container, não o do api-gateway). Rodando o
# storefront fora do Docker, pode deixar em branco (cai para
# NEXT_PUBLIC_API_GATEWAY_URL).
API_GATEWAY_INTERNAL_URL=http://api-gateway:8000
