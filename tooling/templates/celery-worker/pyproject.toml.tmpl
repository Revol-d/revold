[project]
name = "{{dist}}"
version = "0.1.0"
description = "{{description}}"
requires-python = ">=3.12"
# Dependencias internas sem pino: o uv.lock unico e o workspace resolvem a versao.
dependencies = [{{dependencies}}, "celery>=5.4,<6"]

[build-system]
requires = ["hatchling>=1.25,<2"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{import}}"]
