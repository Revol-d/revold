[project]
name = "{{dist}}"
version = "0.1.0"
description = "{{description}}"
requires-python = ">=3.12"
# Dependencias internas sem pino: o uv.lock unico e o workspace resolvem a versao. O `httpx`
# e o que o `TestClient` do FastAPI usa, e serve tambem para a API chamar outras.
dependencies = [{{dependencies}}, "fastapi>=0.115,<0.116", "uvicorn[standard]>=0.30.6,<0.31", "httpx>=0.27.2,<0.28"]

[build-system]
requires = ["hatchling>=1.25,<2"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{import}}"]
