# Imagem da API `{{id}}`. O contexto do build e a RAIZ do monorepo, porque o `uv sync` precisa do
# workspace inteiro (uv.lock e os pyproject dos membros):
#
#   docker build -f {{rel_dir}}/Dockerfile -t {{id}} .
#
# `uv sync --package` instala so esta API e o fecho dela, sem o grupo de dev. O `.dockerignore`
# da raiz deixa de fora .venv, node_modules e o .git.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /repo
COPY . .
RUN uv sync --frozen --no-default-groups --package {{dist}}

ENV PATH="/opt/venv/bin:$PATH"
EXPOSE 8000
CMD ["uvicorn", "--factory", "{{import}}.main:create_app", "--host", "0.0.0.0", "--port", "8000"]
